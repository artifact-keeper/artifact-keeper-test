{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ak-e2e/__SLUG__",
  "description": "Release-gate fixture server",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ak-e2e/fixture",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--yes"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "target_dir",
          "value": "/tmp"
        },
        {
          "type": "named",
          "name": "--mode",
          "value": "ro",
          "choices": [
            "ro",
            "rw"
          ]
        }
      ],
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
