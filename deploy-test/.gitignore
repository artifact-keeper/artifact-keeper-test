# Per-run tier artifacts (JUnit XML, logs) — regenerated by harness/run.sh.
# This also covers throwaway per-slot fixture state such as
# results/migration/nexus-state-slot*/ (admin_password.txt, fixtures.json),
# which must NEVER be tracked.
results/
results/**/nexus-state-*/

# Release-line marker written by scripts/switch-tests-ref.sh when the gate
# moves the working tree to release/X.Y.x (harness/lib/exit_codes.sh, exit 12).
.tests-ref
